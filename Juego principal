#pgzero
import random

TITLE = "Atrapa la Manzana"
WIDTH = 1000
HEIGHT = 600
fps = 100

APPLE_START_Y = -50
BASKET_OFFSET = 50
INITIAL_LIVES = 3
INITIAL_SPEED = 30
BASKET_SPEED = 150

Background5 = Actor("Background", size=(1000, 600))
basket = Actor("basket", (WIDTH // 2, HEIGHT - BASKET_OFFSET))
apple = Actor("apple", (WIDTH // 2, APPLE_START_Y))

score = 0
lives = INITIAL_LIVES
apple_speed = INITIAL_SPEED
game_over = False
paused = False
menu = True
difficulty = 0

move_left = False
move_right = False

highscore_easy = 0
highscore_normal = 0
highscore_hard = 0

def get_random_x():
    return random.randint(60, WIDTH - 50)

def reset_apple_position():
    apple.x = get_random_x()
    apple.y = APPLE_START_Y

def reset_game():
    global score, lives, apple_speed, game_over
    score = 0
    lives = INITIAL_LIVES
    apple_speed = INITIAL_SPEED
    game_over = False
    reset_apple_position()

def apply_speed_increase():
    global apple_speed
    if difficulty == 1:
        apple_speed += 1
    elif difficulty == 2:
        apple_speed += 2
    elif difficulty == 3:
        apple_speed += 5

def update_highscore():
    global highscore_easy, highscore_normal, highscore_hard
    if difficulty == 1 and score > highscore_easy:
        highscore_easy = score
    elif difficulty == 2 and score > highscore_normal:
        highscore_normal = score
    elif difficulty == 3 and score > highscore_hard:
        highscore_hard = score

def move_basket():
    if move_left:
        basket.x -= BASKET_SPEED
    if move_right:
        basket.x += BASKET_SPEED
    if basket.left < 0:
        basket.left = 0
    if basket.right > WIDTH:
        basket.right = WIDTH

def update_gameplay():
    move_basket()
    apple.y += apple_speed
    if apple.y > HEIGHT:
        global lives, game_over
        lives -= 1
        reset_apple_position()
        if lives <= 0:
            update_highscore()
            game_over = True
    if basket.colliderect(apple):
        global score
        score += 1
        apply_speed_increase()
        reset_apple_position()

def draw_menu():
    screen.draw.text("Selecciona dificultad", center=(WIDTH//2, 100), fontsize=70, color="white")
    screen.draw.text("1 - Fácil", center=(WIDTH//2, 200), fontsize=45, color="green")
    screen.draw.text("Highscore: " + str(highscore_easy), center=(WIDTH//2, 250), fontsize=40, color="green")
    screen.draw.text("2 - Normal", center=(WIDTH//2, 330), fontsize=45, color="yellow")
    screen.draw.text("Highscore: " + str(highscore_normal), center=(WIDTH//2, 380), fontsize=40, color="yellow")
    screen.draw.text("3 - Pesadilla", center=(WIDTH//2, 460), fontsize=45, color="red")
    screen.draw.text("Highscore: " + str(highscore_hard), center=(WIDTH//2, 510), fontsize=40, color="red")

def draw_pause():
    screen.draw.text("PAUSADO", center=(WIDTH//2, HEIGHT//2 - 20), fontsize=70, color="yellow")
    screen.draw.text("Presiona espacio para continuar", center=(WIDTH//2, HEIGHT//2 + 40), fontsize=40, color="white")

def draw_game_over():
    screen.draw.text("GAME OVER", center=(WIDTH//2, HEIGHT//2 - 40), fontsize=60, color="red")
    screen.draw.text("Presiona R para reiniciar", center=(WIDTH//2, HEIGHT//2 + 10), fontsize=35, color="white")

def draw_hud():
    screen.draw.text("Puntos: " + str(score), (10, 10), fontsize=35, color="white")
    screen.draw.text("Vidas: " + str(lives), (10, 50), fontsize=35, color="white")

def draw_gameplay():
    Background5.draw()
    basket.draw()
    apple.draw()
    draw_hud()

def draw():
    screen.clear()
    if menu:
        draw_menu()
        return
    if paused:
        draw_pause()
        return
    if game_over:
        draw_game_over()
        return
    draw_gameplay()

def update(dt):
    if not menu and not paused and not game_over:
        update_gameplay()

def on_key_down(key):
    global move_left, move_right, paused, menu, difficulty
    if menu:
        if key == keys.K_1:
            difficulty = 1
            menu = False
        elif key == keys.K_2:
            difficulty = 2
            menu = False
        elif key == keys.K_3:
            difficulty = 3
            menu = False
        return
    if key == keys.LEFT:
        move_left = True
    if key == keys.RIGHT:
        move_right = True
    if key == keys.SPACE:
        global paused
        paused = not paused
    if game_over and key == keys.R:
        reset_game()
        menu = True

def on_key_up(key):
    global move_left, move_right
    if key == keys.LEFT:
        move_left = False
    if key == keys.RIGHT:
        move_right = False

def on_mouse_move(pos):
    if not menu and not paused and not game_over:
        basket.x = pos[0]
